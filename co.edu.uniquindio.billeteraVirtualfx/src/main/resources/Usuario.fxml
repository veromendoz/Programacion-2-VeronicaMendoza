<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Separator?>

<AnchorPane prefHeight="534.0" prefWidth="764.0" style="-fx-background-color: #48426D;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.billeteravirtual.billeteravirtual.viewcontroller.UsuarioViewController">
    <children>
        <SplitPane dividerPositions="0.45" layoutX="11.0" layoutY="42.0" orientation="VERTICAL" prefHeight="472.0" prefWidth="742.0" style="-fx-background-color: #312C51;">
            <items>
                <!-- PANEL SUPERIOR -->
                <AnchorPane prefHeight="207.0" prefWidth="741.0" style="-fx-background-color: #edfcf9;">
                    <children>
                        <Label layoutX="20.0" layoutY="15.0" text="Gestión de Usuarios">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>

                        <Label layoutX="30.0" layoutY="50.0" text="ID Usuario:" />
                        <TextField fx:id="txtIdUsuario" layoutX="130.0" layoutY="45.0" prefWidth="180.0" />

                        <Label layoutX="30.0" layoutY="85.0" text="Nombre:" />
                        <TextField fx:id="txtNombre" layoutX="130.0" layoutY="80.0" prefWidth="180.0" />

                        <Label layoutX="30.0" layoutY="120.0" text="Email:" />
                        <TextField fx:id="txtEmail" layoutX="130.0" layoutY="115.0" prefWidth="180.0" />

                        <Label layoutX="380.0" layoutY="50.0" text="Celular:" />
                        <TextField fx:id="txtCelular" layoutX="480.0" layoutY="45.0" prefWidth="180.0" />

                        <Label layoutX="380.0" layoutY="85.0" text="Contraseña:" />
                        <TextField fx:id="txtPassword" layoutX="480.0" layoutY="80.0" prefWidth="180.0" />

                        <Label layoutX="380.0" layoutY="120.0" text="Saldo Total:" />
                        <TextField fx:id="txtSaldoTotal" layoutX="480.0" layoutY="115.0" prefWidth="180.0" />

                        <Separator layoutX="20.0" layoutY="155.0" prefWidth="700.0" />

                        <Button fx:id="btnAgregar" layoutX="198.0" layoutY="170.0" onAction="#agregarUsuario" prefWidth="100.0" style="-fx-background-color: #312C51;" text="Agregar" textFill="WHITE" />
                        <Button fx:id="btnActualizar" layoutX="319.0" layoutY="170.0" onAction="#actualizarUsuario" prefWidth="100.0" style="-fx-background-color: #312C51;" text="Actualizar" textFill="WHITE" />
                        <Button fx:id="btnLimpiar" layoutX="437.0" layoutY="170.0" onAction="#limpiarCampos" prefWidth="100.0" style="-fx-background-color: #312C51;" text="Limpiar" textFill="WHITE" />
                    </children>
                </AnchorPane>

                <!-- PANEL INFERIOR -->
                <AnchorPane prefHeight="246.0" prefWidth="741.0" style="-fx-background-color: #edfcf9;">
                    <children>
                        <TableView fx:id="tableUsuarios" layoutX="30.0" layoutY="20.0" prefHeight="190.0" prefWidth="680.0">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="80" style="-fx-background-color: #F1AA9B;" text="ID" />
                                <TableColumn fx:id="colNombre" prefWidth="100" style="-fx-background-color: #F1AA9B;" text="Nombre" />
                                <TableColumn fx:id="colEmail" prefWidth="120" style="-fx-background-color: #F1AA9B;" text="Email" />
                                <TableColumn fx:id="colCelular" prefWidth="100" style="-fx-background-color: #F1AA9B;" text="Celular" />
                                <TableColumn fx:id="colPassword" prefWidth="100" style="-fx-background-color: #F1AA9B;" text="Contraseña" />
                                <TableColumn fx:id="colSaldoTotal" prefWidth="80" style="-fx-background-color: #F1AA9B;" text="Saldo" />
                            </columns>
                        </TableView>

                        <Button fx:id="btnEliminarTabla" layoutX="610.0" layoutY="215.0" onAction="#eliminarUsuario" prefHeight="26.0" prefWidth="100.0" style="-fx-background-color: #312C51;" text="Eliminar" textFill="WHITE" />
                        <Button fx:id="btnVolverInicio" layoutX="30.0" layoutY="215.0" onAction="#volverInicio" prefHeight="31.0" prefWidth="123.0" style="-fx-background-color: #312C51;" text="Volver al Inicio" textFill="WHITE" />
                    </children>
                </AnchorPane>
            </items>
        </SplitPane>
        <Label layoutX="30.0" layoutY="14.0" text="Gestión Usuarios" textFill="WHITE">
            <font>
                <Font name="System Bold Italic" size="14.0" />
            </font>
        </Label>
    </children>
</AnchorPane>
